# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_USE_SQLITE=false
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Billing (simplified credit system; .env.example disables it for self-hosting)
BILLING_ENABLED=false
BILLING_STARTING_CREDITS=100

# PostgreSQL (db is reachable from api/celery-worker on the compose network)
POSTGRES_DB=model_deployer
POSTGRES_USER=ml_user
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# MinIO (S3-compatible object storage; reachable on the compose network)
MINIO_ROOT_USER=replace-with-a-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
MINIO_BUCKET=model-artifacts
MINIO_ENDPOINT=http://minio:9000
MINIO_USE_SSL=false

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# Inference runner (single FastAPI worker on the compose network)
RUNNER_SKLEARN_URL=http://worker:8002
RUNNER_PYTORCH_URL=http://worker:8002

# Guardrails
MAX_MODEL_ZIP_BYTES=52428800
INFERENCE_TIMEOUT_SECONDS=15
PREDICTION_CACHE_TTL_SECONDS=300
PREDICTION_CACHE_VERSION=v1

# Host-side published ports (only api and frontend are exposed)
API_PORT=8000
FRONTEND_PORT=80
