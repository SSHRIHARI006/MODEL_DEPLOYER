# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_USE_SQLITE=false
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Billing (simplified credit system; .env.example disables it for self-hosting)
BILLING_ENABLED=false
BILLING_STARTING_CREDITS=100

# SEC-05: deposit credits are simulated, not payments. Keep this false in
# production; when true, deposits still require a staff account (or DJANGO_DEBUG).
BILLING_DEMO_DEPOSITS=false
BILLING_MAX_DEPOSIT_AMOUNT=10000

# PostgreSQL (db is reachable from api/celery-worker on the compose network)
POSTGRES_DB=model_deployer
POSTGRES_USER=ml_user
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# MinIO (S3-compatible object storage; reachable on the compose network)
# Root credentials are used by the API and the one-shot bootstrap job only.
MINIO_ROOT_USER=replace-with-a-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
MINIO_BUCKET=model-artifacts
MINIO_ENDPOINT=http://minio:9000
MINIO_USE_SSL=false

# Scoped, read-only identity for the inference runner (SEC-01). The
# `minio-init` service creates it and attaches the read-only policy in
# deploy/minio/worker-artifacts-readonly-policy.json. It cannot write or delete.
MINIO_WORKER_USER=replace-with-a-runner-storage-user
MINIO_WORKER_PASSWORD=replace-with-a-strong-runner-storage-password

# Redis / Celery
# SEC-08: Redis requires authentication. REDIS_PASSWORD is what the server is
# started with; the URLs below must carry the same password (or `redis-cli -a`
# and the app will get NOAUTH). Redis is never published to the host.
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_URL=redis://:replace-with-a-strong-redis-password@redis:6379/0
CELERY_BROKER_URL=redis://:replace-with-a-strong-redis-password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:replace-with-a-strong-redis-password@redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false
CELERY_WORKER_CONCURRENCY=2

# PERF-01: Warm model runtime manager. Disabled by default (SEC-02): enable
# only where the bounded IPC path and the deployment's resource limits are
# accepted. Warm children share the runner's security boundary (see
# docs/security.md, SEC-01).
RUNNER_WARM_RUNTIME_ENABLED=false
RUNNER_MAX_WARM_MODELS=5

# SEC-07: scoped rate limiting for auth, uploads, key management, deposits,
# and predictions. Set to false only if a reverse proxy handles rate limiting.
THROTTLING_ENABLED=true

# Inference runner (single FastAPI worker on the compose network)
RUNNER_SKLEARN_URL=http://worker:8002
RUNNER_PYTORCH_URL=http://worker:8002

# Runner authentication (SEC-02): shared secret sent in the header below on
# every internal model-management/inference call. Required unless DJANGO_DEBUG
# or RUNNER_ALLOW_UNAUTHENTICATED is true; generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RUNNER_AUTH_TOKEN=replace-with-a-long-random-shared-secret
RUNNER_AUTH_HEADER=X-Runner-Token
# Development-only escape hatch; never enable this on an exposed host.
# RUNNER_ALLOW_UNAUTHENTICATED=true

# Guardrails
# SEC-03: uploaded models are installed and executed as code, so uploads are
# restricted to staff and to accounts approved in the admin
# (`can_upload_models`). Set to false to let any authenticated user upload.
UPLOAD_APPROVAL_REQUIRED=true
MAX_MODEL_ZIP_BYTES=52428800

# SEC-04 archive limits: checked against the ZIP metadata before extraction and
# enforced again while bytes are written. 0 for MAX_MODEL_COMPRESSION_RATIO
# disables the expansion-ratio check.
MAX_MODEL_UNCOMPRESSED_BYTES=209715200
MAX_MODEL_ENTRY_BYTES=52428800
MAX_MODEL_ARCHIVE_ENTRIES=512
MAX_MODEL_PATH_LENGTH=200
MAX_MODEL_COMPRESSION_RATIO=100
INFERENCE_TIMEOUT_SECONDS=15
PREDICTION_CACHE_TTL_SECONDS=300
PREDICTION_CACHE_VERSION=v1

# REL-01 / REL-03: runner timeouts and bounded execution limits
RUNNER_INIT_TIMEOUT_SECONDS=300
RUNNER_PREDICT_TIMEOUT_SECONDS=15
RUNNER_HEALTHCHECK_TIMEOUT_SECONDS=30
RUNNER_COMMAND_TIMEOUT_SECONDS=60
RUNNER_MAX_OUTPUT_BYTES=131072
RUNNER_MAX_CONCURRENT_BUILDS=1
RUNNER_MAX_CONCURRENT_PREDICTIONS=8

# REL-10: Gunicorn configuration for production API container
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30

# Host-side published ports (only api and frontend are exposed)
API_PORT=8000
FRONTEND_PORT=80
